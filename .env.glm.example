# Ustaw tylko w sekretnym środowisku serwera (Vercel/Railway/local .env.local).
# NIE umieszczaj kluczy w NEXT_PUBLIC_ ani w przeglądarce.
EXPLABS_API_KEY=
# Ustaw długi losowy ciąg (min 16 znaków); wymagany, by publiczny URL nie nadużywał płatnego API.
JEFF_CHAT_ACCESS_TOKEN=
# Potwierdzony identyfikator na stronie dostawcy; dostawca musi udzielać dostępu do modelu.
EXPLABS_MODEL=glm-5.3-flash-uncensored
EXPLABS_MAX_OUTPUT_TOKENS=4096