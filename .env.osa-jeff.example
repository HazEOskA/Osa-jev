# Example only. Never commit real secrets or identifiers.
AUTH_SECRET=GENERATE_RANDOM_32_CHARACTERS_OR_LONGER
AUTH_GOOGLE_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
AUTH_GOOGLE_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
# Exactly two verified Google email addresses, comma-separated; OAuth sub is bound on first sign-in.
OSA_JEFF_ALLOWED_EMAILS=person1@example.com,person2@example.com
# Separate least-privilege role (NOBYPASSRLS, not schema owner).
DATABASE_URL=postgresql://osa_jeff_app:REPLACE@YOUR_HOST/osa_jeff_p0?sslmode=verify-full
# 32 cryptographically random bytes encoded using standard base64.
OSA_JEFF_MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
EXPLABS_API_KEY=EXISTING_SERVER_SIDE_EXPLABS_KEY
EXPLABS_MODEL=glm-5.3-flash-uncensored
